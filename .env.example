# Application Configuration
PROJECT_NAME="Fitness Studio Booking API"
VERSION="1.0.0"

# Database Configuration (SQLite default, can be replaced with PostgreSQL)
DATABASE_URL="sqlite:///./fitness_booking.db"

# Security & JWT Configuration
# In production, generate a cryptographically strong random key (e.g. openssl rand -hex 32)
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Application Timezone (IST: Indian Standard Time UTC+05:30)
APP_TIMEZONE="Asia/Kolkata"
